@startuml
skinparam componentStyle rectangle
skinparam rectangleBorderColor #4D4FEB
skinparam rectangleFontColor #0f172a
skinparam arrowColor #425CEC
skinparam packageTitleFontColor #0f172a
skinparam packageBorderColor #d1d5db

package "Frontend (Next.js Quizz App)" {
  [App Page (page.tsx)] <<UI>>
  [API Client (streamQuizQuestions)] <<API>>
  [QuizRenderer (quiz-render.tsx)] <<UI>>
  [Question Components] <<UI>>
  [useQuizState (hook)] <<State>>
  [Core Utils] <<Helpers>>
}

package "Backend (FastAPI)" {
  [FastAPI App] <<Server>>
  [Endpoint /run (SSE)] <<HTTP>>
  [Graph Engine (LangGraph)] <<Orchestrator>>
  [State (TypedDict)] <<Data>>
  [Retrieval Node] <<Adapter>>
  [LLM Node] <<LLM>>
}

package "External Services" {
  [RAGFlow Retrieval API] <<HTTP>>
  [Google Gemini 2.5 Flash] <<LLM API>>
}

' Frontend relationships
[App Page (page.tsx)] --> [API Client (streamQuizQuestions)] : POST+SSE
[App Page (page.tsx)] --> [QuizRenderer (quiz-render.tsx)]
[QuizRenderer (quiz-render.tsx)] --> [Question Components]
[QuizRenderer (quiz-render.tsx)] --> [useQuizState (hook)]
[useQuizState (hook)] --> [Core Utils]

' Frontend ↔ Backend
[API Client (streamQuizQuestions)] ..> [Endpoint /run (SSE)] : POST { message }
[Endpoint /run (SSE)] --> [API Client (streamQuizQuestions)] : stream JSON objects

' Backend orchestration
[Endpoint /run (SSE)] --> [Graph Engine (LangGraph)] : state { prompt }
[Graph Engine (LangGraph)] --> [Retrieval Node]
[Graph Engine (LangGraph)] --> [LLM Node]
[Retrieval Node] -right-> [Graph Engine (LangGraph)] : { context }
[LLM Node] -left-> [Graph Engine (LangGraph)] : { output }
[Graph Engine (LangGraph)] --> [Endpoint /run (SSE)] : stream payloads

' External service calls
[Retrieval Node] ..> [RAGFlow Retrieval API]
[LLM Node] ..> [Google Gemini 2.5 Flash]

' Notes with file references
note right of [Endpoint /run (SSE)]
  Implements SSE: serializes payloads
  and yields up to 3 messages.
  Files:
  - backend/api.py
end note

note bottom of [Graph Engine (LangGraph)]
  Built via StateGraph:
  - builder: backend/graph/builder.py
  - state: backend/graph/state.py
  - nodes: backend/graph/nodes/*
end note

note left of [API Client (streamQuizQuestions)]
  Consumes SSE and yields per-message
  File: frontend/quizz/src/api.ts
end note

note left of [QuizRenderer (quiz-render.tsx)]
  Renders questions, progress, timer,
  and handles submission UI.
  File: frontend/quizz/src/quiz-render.tsx
end note

note left of [useQuizState (hook)]
  Manages answers, flags, errors,
  progress, and submit.
  File: frontend/quizz/src/hook/useQuizState.ts
end note

note left of [Core Utils]
  Validation & scroll helpers:
  - frontend/quizz/src/core/validateAnswer.ts
  - frontend/quizz/src/core/scrollToError.ts
end note

@enduml